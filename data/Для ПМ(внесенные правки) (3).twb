    <worksheet name='2.3.1 BAR отрасля'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='0' fontname='Manrope'>   План освоения по отраслям</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='DS_DM_PM_PLAN' name='federated.1db8l2s1lub32n195l3cf1536vbs' />
          </datasources>
          <datasource-dependencies datasource='federated.1db8l2s1lub32n195l3cf1536vbs'>
            <column caption='Освоение за выбранный год (регионы)' datatype='integer' name='[Calculation_2937381141053468]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [REPORT_DATE], [REGION], [PROJECT_STAGE] :&#13;&#10;    sum(case YEAR([REPORT_DATE])&#13;&#10;        WHEN 2025 THEN [DISBURSEMENT_2025_PLAN]&#13;&#10;        WHEN 2026 THEN [DISBURSEMENT_2026_PLAN]&#13;&#10;        WHEN 2027 then [DISBURSEMENT_2027_PLAN]&#13;&#10;        WHEN 2028 then [DISBURSEMENT_2028_PLAN]&#13;&#10;    END)&#13;&#10;}' />
            </column>
            <column caption='Disbursement 2025 Fact' datatype='integer' name='[DISBURSEMENT_2025_FACT]' role='measure' type='quantitative' />
            <column caption='Disbursement 2025 Plan' datatype='integer' name='[DISBURSEMENT_2025_PLAN]' role='measure' type='quantitative' />
            <column caption='Disbursement 2026 Fact' datatype='integer' name='[DISBURSEMENT_2026_FACT]' role='measure' type='quantitative' />
            <column caption='Disbursement 2026 Plan' datatype='integer' name='[DISBURSEMENT_2026_PLAN]' role='measure' type='quantitative' />
            <column caption='Disbursement 2027 Plan' datatype='integer' name='[DISBURSEMENT_2027_PLAN]' role='measure' type='quantitative' />
            <column caption='Disbursement 2028 Plan' datatype='integer' name='[DISBURSEMENT_2028_PLAN]' role='measure' type='quantitative' />
            <column caption='Dm Date' datatype='date' name='[DM_DATE]' role='dimension' type='ordinal' />
            <column datatype='string' name='[DO]' role='dimension' type='nominal' />
            <column caption='Industry' datatype='string' name='[INDUSTRY]' role='dimension' type='nominal' />
            <column aggregation='Avg' caption='Latitude' datatype='real' name='[LATITUDE]' role='measure' semantic-role='[Geographical].[Latitude]' type='quantitative' />
            <column aggregation='Avg' caption='Longitude' datatype='real' name='[LONGITUDE]' role='measure' semantic-role='[Geographical].[Longitude]' type='quantitative' />
            <column caption='Project Stage' datatype='string' name='[PROJECT_STAGE]' role='dimension' type='nominal' />
            <column caption='Project Type' datatype='string' name='[PROJECT_TYPE]' role='dimension' type='nominal' />
            <column caption='Region' datatype='string' name='[REGION]' role='dimension' type='nominal'>
              <aliases>
                <alias key='%null%' value='Межрегиональный ' />
              </aliases>
            </column>
            <column caption='Report Date' datatype='date' datatype-customized='true' default-format='*dd.mm.yyyy' name='[REPORT_DATE]' role='dimension' type='ordinal' />
            <column caption='Requested Approved Amount' datatype='integer' name='[REQUESTED_APPROVED_AMOUNT]' role='measure' type='quantitative' />
            <column caption='Src Id' datatype='integer' name='[SRC_ID]' role='dimension' type='ordinal' />
            <column-instance column='[SRC_ID]' derivation='Count' name='[cnt:SRC_ID:qk]' pivot='key' type='quantitative' />
            <column-instance column='[DM_DATE]' derivation='None' name='[none:DM_DATE:ok]' pivot='key' type='ordinal' />
            <column-instance column='[DO]' derivation='None' name='[none:DO:nk]' pivot='key' type='nominal' />
