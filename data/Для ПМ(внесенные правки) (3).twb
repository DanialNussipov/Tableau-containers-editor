        <calculation class='tableau' formula='{ FIXED : &#13;&#10;    IF MIN({ FIXED : COUNTD([DO]) }) = 1 THEN &#13;&#10;        SUM({ FIXED [DO] : MAX([Calculation_0598171969802278]) })&#13;&#10;    ELSE &#13;&#10;        8000000 &#13;&#10;    END &#13;&#10;}' />
