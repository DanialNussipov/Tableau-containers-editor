        <named-connections>
          <named-connection caption='DS_DM_PLAN_EXECUTION' name='federated.0uk7vcd14kgxuc1g2jtyx02io0v5leaf'>
            <connection access_mode='readonly' authentication='auth-none' author-locale='en_US' class='hyper' dbname='C:/tableau_style_manager/data/Для ПМ(внесенные правки) (3).twb Files/Data/Для ПМ (5).twb Files/DS_DM_PLAN_EXECUTION.hyper' default-settings='yes' schema='Extract' sslmode='' tablename='Extract' update-time='08/19/2026 06:39:33 AM' username='tableau_internal_user' />
          </named-connection>
        </named-connections>
        <relation type='collection'>
          <relation connection='federated.0uk7vcd14kgxuc1g2jtyx02io0v5leaf' name='DM_PLAN_EXECUTION' table='[SANDBOX].[DM_PLAN_EXECUTION]' type='table' />
          <relation connection='federated.0uk7vcd14kgxuc1g2jtyx02io0v5leaf' name='D_FINANSING_PLAN' table='[DWH].[D_FINANSING_PLAN]' type='table' />
          <relation connection='federated.0uk7vcd14kgxuc1g2jtyx02io0v5leaf' name='Custom SQL Query' type='text'>WITH CTE AS (&#13;
    SELECT &#13;
        dpe.*,&#13;
        MAX(DM_DATE) OVER (PARTITION BY YEAR(DM_DATE)) AS MAX_YEAR_DATE&#13;
    FROM SANDBOX.DM_PLAN_EXECUTION dpe&#13;
    WHERE HIERARCHY_LEVEL = 1&#13;
)&#13;
SELECT &#13;
    YEAR(DM_DATE) AS YR, &#13;
    DO, &#13;
    SUM(FACT) AS TOTAL_FACT&#13;
FROM CTE&#13;
WHERE DM_DATE = MAX_YEAR_DATE&#13;
GROUP BY YEAR(DM_DATE), DO</relation>
        </relation>
