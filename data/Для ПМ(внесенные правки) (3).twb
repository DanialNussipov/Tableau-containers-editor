      <column caption='дата для ареа' datatype='boolean' name='[Calculation_0598171889876997]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[DM_DATE] &lt;= [Parameters].[Дата отчета Parameter]&#13;&#10;AND&#13;&#10;YEAR([DM_DATE]) = YEAR([Parameters].[Дата отчета Parameter])' />
      </column>
      <column caption='Calculation1' datatype='boolean' name='[Calculation_0598171892654086]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;year&apos;, [DM_DATE]) = DATETRUNC(&apos;year&apos;, [Parameters].[Dm Date Parameter])' />
