              <calculation class='tableau' formula='if [REQUESTED_APPROVED_AMOUNT] - [DISBURSEMENT_2028_PLAN] - [DISBURSEMENT_2027_PLAN] - [DISBURSEMENT_2026_FACT] - [viz_Disbursement 2025 Plan (copy)_2937381123633171] - [DISBURSEMENT_2025_FACT] - [Calculation_2937381115060242] &lt; 0    then 0  &#13;&#10;else [REQUESTED_APPROVED_AMOUNT] - [DISBURSEMENT_2028_PLAN] - [DISBURSEMENT_2027_PLAN] - [DISBURSEMENT_2026_FACT] - [viz_Disbursement 2025 Plan (copy)_2937381123633171] - [DISBURSEMENT_2025_FACT] - [Calculation_2937381115060242]&#13;&#10;end' />
