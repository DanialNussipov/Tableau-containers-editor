      <column caption='Approval Probability' datatype='string' name='[APPROVAL_PROBABILITY]' role='dimension' type='nominal' />
      <column caption='Borrower Name' datatype='string' name='[BORROWER_NAME]' role='dimension' type='nominal' />
      <column caption='Branch' datatype='string' name='[BRANCH]' role='dimension' type='nominal' />
      <column caption='cnt project type' datatype='integer' name='[Calculation_0145446877949956]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([PROJECT_TYPE])' />
      </column>
      <column caption='Средн чек портфеля' datatype='real' name='[Calculation_0598171927457805]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([PROJECT_COST_MLN])/[Calculation_1061614688612382]' />
      </column>
      <column caption='Процент освоения' datatype='real' name='[Calculation_0598171929485329]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[DISBURSEMENT_2026_FACT] / [DISBURSEMENT_2026_PLAN]' />
      </column>
      <column caption='Кол-во проектов' datatype='integer' name='[Calculation_1061614688612382]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([PROJECT_NAME])' />
      </column>
      <column caption='fact amount' datatype='integer' name='[Calculation_1061614692098080]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE YEAR([DM_DATE])&#13;&#10;    WHEN 2025 THEN [DISBURSEMENT_2025_FACT]&#13;&#10;    WHEN 2026 THEN [DISBURSEMENT_2026_FACT]&#13;&#10;    ELSE 0&#13;&#10;END' />
      </column>
      <column caption='освоение от плана' datatype='real' name='[Calculation_1061614693642274]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([Calculation_1061614692098080])) / NULLIF(SUM([fact amount (copy)_1061614692823073]), 0)' />
