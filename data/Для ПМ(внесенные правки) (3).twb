              <calculation class='tableau' formula='CASE YEAR([DM_DATE])&#13;&#10;    WHEN 2025 THEN [DISBURSEMENT_2025_FACT]&#13;&#10;    WHEN 2026 THEN [DISBURSEMENT_2026_FACT]&#13;&#10;    ELSE 0&#13;&#10;END' />
