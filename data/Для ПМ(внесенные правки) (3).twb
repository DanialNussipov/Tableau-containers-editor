      <column caption='viz_Disbursement 2025 Plan' datatype='integer' name='[Calculation_2937381115060242]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [DISBURSEMENT_2025_PLAN] - [DISBURSEMENT_2025_FACT] &lt;= 0 then 0&#13;&#10;else [DISBURSEMENT_2025_PLAN] - [DISBURSEMENT_2025_FACT]&#13;&#10;end' />
