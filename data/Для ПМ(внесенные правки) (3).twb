          </datasources>
          <datasource-dependencies datasource='federated.1db8l2s1lub32n195l3cf1536vbs'>
            <column caption='Фильтр межрегиональных проектов' datatype='boolean' name='[Calculation_2937381203345441]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='ISNULL([REGION]) OR [REGION] = &apos;Межрегиональные&apos;' />
            </column>
            <column caption='Dm Date' datatype='date' name='[DM_DATE]' role='dimension' type='ordinal' />
            <column caption='Project Stage' datatype='string' name='[PROJECT_STAGE]' role='dimension' type='nominal' />
