              <relation name='D_FINANSING_PLAN (DWH.D_FINANSING_PLAN)_971DCE355EFA472E9CDA1A836F07023F' table='[Extract].[D_FINANSING_PLAN (DWH.D_FINANSING_PLAN)_971DCE355EFA472E9CDA1A836F07023F]' type='table' />
