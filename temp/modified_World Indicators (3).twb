      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='100000' id='1' param='vert' removable='false' type-v2='layout-flow' w='100000' x='0' y='0'>
            <zone h='5526' id='3' type-v2='title' w='100000' x='0' y='0' />
            <zone fixed-size='125' h='16447' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='100000' x='0' y='5526' />
            <zone h='78027' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='100000' x='0' y='21973'>
              <flipboard active-id='1' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='Global population and birth rate are imbalanced.' captured-sheet='Population' id='1' />
                  <story-point caption='A few countries spend more than 14% GDP on health care.' captured-sheet='Care Spend' id='2' />
                  <story-point caption='Mobile phone usage grows much faster than internet usage.' captured-sheet='Technology' id='3'>
                    <capturedDeltas>
                      <worksheet name='Technology'>
                        <filter class='categorical' column='[federated.0nwrb8b1xoqnsf1dnja360y7cceu].[none:Region:nk]'>
                          <groupfilter function='member' level='[none:Region:nk]' member='&quot;The Americas&quot;' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
                        </filter>
                      </worksheet>
                    </capturedDeltas>
                  </story-point>
                  <story-point caption='Following negative economic growth, we see interest rates decline.' captured-sheet='Economy' id='4'>
                    <capturedDeltas>
                      <worksheet name='Economy'>
                        <filter class='categorical' column='[federated.0nwrb8b1xoqnsf1dnja360y7cceu].[none:Region:nk]'>
                          <groupfilter function='member' level='[none:Region:nk]' member='&quot;Africa&quot;' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
                        </filter>
                      </worksheet>
                    </capturedDeltas>
                  </story-point>
                  <story-point caption='Europe continues to be the most popular tourist destination.' captured-sheet='Tourism' id='5' />
                  <story-point caption='High GDP correlates with ease of business.' captured-sheet='Business' id='6' />
                </story-points>
              </flipboard>
            </zone>
          </zone>
        </zone>
      </zones>
